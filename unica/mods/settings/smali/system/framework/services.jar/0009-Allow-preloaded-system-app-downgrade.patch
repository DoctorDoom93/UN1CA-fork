From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UN1CA <noreply@unica>
Subject: [PATCH] Allow preloaded system app downgrade

Android 17: anchor the toggle in verifyReplacingVersionCode with
isUnicaDowngradeAllowed helper using ActivityThread context.
---
diff --git a/smali_classes2/com/android/server/pm/PackageManagerService.smali b/smali_classes2/com/android/server/pm/PackageManagerService.smali
index 6a026b3..b6731a6 100644
--- a/smali_classes2/com/android/server/pm/PackageManagerService.smali
+++ b/smali_classes2/com/android/server/pm/PackageManagerService.smali
@@ -22383,6 +22383,14 @@
     invoke-interface {v14}, Lcom/android/server/pm/pkg/AndroidPackage;->isDebuggable()Z
 
     move-result v0
+
+    if-nez v0, :unica_preloaded_downgrade_checked
+
+    invoke-static {}, Lcom/android/server/pm/PackageManagerService;->isUnicaDowngradeAllowed()Z
+
+    move-result v0
+
+    :unica_preloaded_downgrade_checked
     :try_end_251
     .catchall {:try_start_22b .. :try_end_251} :catchall_1d3
 
-- 
2.51.2
