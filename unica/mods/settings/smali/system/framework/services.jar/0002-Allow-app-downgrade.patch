From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UN1CA <noreply@unica>
Subject: [PATCH] Allow app downgrade

Android 17: anchor the toggle in verifyReplacingVersionCode with
isUnicaDowngradeAllowed helper using ActivityThread context.
---
diff --git a/smali_classes2/com/android/server/pm/PackageManagerService.smali b/smali_classes2/com/android/server/pm/PackageManagerService.smali
index c1eeb87..6a026b3 100644
--- a/smali_classes2/com/android/server/pm/PackageManagerService.smali
+++ b/smali_classes2/com/android/server/pm/PackageManagerService.smali
@@ -21724,6 +21724,46 @@
     return-void
 .end method
 
+.method private static isUnicaDowngradeAllowed()Z
+    .registers 3
+
+    invoke-static {}, Landroid/app/ActivityThread;->currentApplication()Landroid/app/Application;
+
+    move-result-object v0
+
+    if-nez v0, :cond_get_resolver
+
+    invoke-static {}, Landroid/app/ActivityThread;->currentSystemContext()Landroid/app/ContextImpl;
+
+    move-result-object v0
+
+    if-nez v0, :cond_get_resolver
+
+    const/4 v0, 0x0
+
+    return v0
+
+    :cond_get_resolver
+    invoke-virtual {v0}, Landroid/content/Context;->getContentResolver()Landroid/content/ContentResolver;
+
+    move-result-object v0
+
+    const-string/jumbo v1, "unica_allow_downgrade"
+
+    const/4 v2, 0x0
+
+    invoke-static {v0, v1, v2}, Landroid/provider/Settings$System;->getInt(Landroid/content/ContentResolver;Ljava/lang/String;I)I
+
+    move-result v0
+
+    if-eqz v0, :cond_done
+
+    const/4 v2, 0x1
+
+    :cond_done
+    return v2
+.end method
+
 .method public final verifyReplacingVersionCode(Landroid/content/pm/PackageInfoLite;JI)Landroid/util/Pair;
     .registers 25
 
@@ -22139,6 +22179,14 @@
     invoke-static {v3, v0}, Lcom/android/server/pm/PackageManagerServiceUtils;->isDowngradePermitted(IZ)Z
 
     move-result v0
+
+    if-nez v0, :unica_downgrade_checked
+
+    invoke-static {}, Lcom/android/server/pm/PackageManagerService;->isUnicaDowngradeAllowed()Z
+
+    move-result v0
+
+    :unica_downgrade_checked
     :try_end_19b
     .catchall {:try_start_193 .. :try_end_19b} :catchall_12a
 
-- 
2.51.2
